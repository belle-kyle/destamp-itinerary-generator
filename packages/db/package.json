{
  "name": "@destamp/db",
  "version": "0.1.0",
  "main": "./index.ts",
  "types": "./index.ts",
  "scripts": {
    "clean": "git clean -xdf node_modules",
    "dev": "pnpm with-env ts-node-dev --no-notify --respawn --transpile-only src",
    "db:generate": "pnpm with-env prisma generate",
    "db:push": "pnpm with-env prisma db push --skip-generate",
    "db:migrate": "pnpm with-env prisma migrate dev",
    "db:seed": "pnpm with-env prisma db seed",
    "db:reset": "pnpm with-env npx prisma migrate reset",
    "with-env": "dotenv -e ../../.env --",
    "nexus:generate": "ts-node --transpile-only src/graphql/schema/index.ts",
    "generate": "pnpm db:generate",
    "lint": "eslint .",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier --check \"**/*.{mjs,ts,md}\"",
    "format:fix": "prettier --write \"**/*.{mjs,ts,md}\"",
    "test": "jest",
    "type-check": "tsc --noEmit"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@apollo/server": "^4.13.0",
    "@prisma/client": "^5.22.0",
    "@turf/turf": "^7.4.0",
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.6",
    "cors": "^2.8.6",
    "date-fns": "^2.30.0",
    "express": "^4.22.2",
    "graphql": "^16.14.2",
    "graphql-scalars": "^1.25.0",
    "jest-mock-extended": "^3.0.7",
    "jsonwebtoken": "^9.0.3",
    "nexus": "^1.3.0",
    "nexus-validate": "^1.4.0",
    "ts-node-dev": "^2.0.0",
    "yup": "^0.32.11"
  },
  "devDependencies": {
    "@destamp/eslint-config": "^0.2.0",
    "@destamp/prettier-config": "^0.1.0",
    "@destamp/tailwind-config": "^0.1.0",
    "@destamp/tsconfig": "^0.1.0",
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "dotenv-cli": "^7.4.4",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@destamp/eslint-config/base"
    ],
    "ignorePatterns": [
      "/src/graphql/generated/nexus.ts",
      "/prisma/seed.ts"
    ]
  },
  "prettier": "@destamp/prettier-config"
}
