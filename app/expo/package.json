{
  "name": "@destamp/expo",
  "version": "0.1.0",
  "private": true,
  "main": "index.tsx",
  "scripts": {
    "clean": "git clean -xdf .expo .turbo node_modules",
    "dev": "expo start",
    "dev:android": "expo start --android",
    "dev:ios": "expo start --ios",
    "test": "jest",
    "lint": "eslint .",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier --check  \"**/*.{js,cjs,mjs,ts,tsx,md}\"",
    "format:fix": "prettier --write \"**/*.{js,cjs,mjs,ts,tsx,md}\"",
    "type-check": "tsc --noEmit",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "generate": "graphql-codegen --config codegen.ts",
    "web:build": "expo export --platform web",
    "web:serve": "python serve-web.py",
    "web:preview": "expo export --platform web && python serve-web.py"
  },
  "dependencies": {
