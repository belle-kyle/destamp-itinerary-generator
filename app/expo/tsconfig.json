{
  "extends": "@destamp/tsconfig/base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "react-model": [
        "./src/types/react-model.d.ts"
      ],
      "react-native-wheel-scrollview-picker": [
        "./src/types/wheel-scrollview-picker.d.ts"
      ]
    },
    "jsx": "react-native",
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo.json",
    "types": [
      "nativewind/types",
      "jest"
    ]
  },
  "include": [
    "expo-plugins",
    "src",
    "*.ts",
    "index.tsx",
    "*.js",
    "jest.config.js",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
